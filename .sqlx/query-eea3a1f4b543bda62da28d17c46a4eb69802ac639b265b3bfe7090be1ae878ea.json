  "query": "\n            INSERT INTO tips (\n                amount,\n                transfer_id,\n                channel_id,\n                message_id,\n                user_id\n            )\n            VALUES ($1, $2, $3, $4, $5)\n            RETURNING\n                id,\n                EXTRACT(EPOCH FROM created_at)::BIGINT AS \"created_at!\",\n                channel_id,\n                message_id,\n                amount,\n                transfer_id,\n                user_id\n            ",
