{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                EXTRACT(EPOCH FROM created_at)::BIGINT AS \"created_at!\",\n                channel_id,\n                message_id,\n                CAST(amount AS BIGINT) as \"amount!\",\n                user_id,\n                transfer_id\n            FROM\n                tips\n            WHERE\n                channel_id = $1 AND message_id = $2 AND user_id = $3\n            ",
