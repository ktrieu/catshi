  "query": "\n            INSERT INTO transfers (\n                amount,\n                sender,\n                receiver,\n                memo,\n                source\n            )\n            VALUES ($1, $2, $3, $4, $5)\n            RETURNING\n                id,\n                amount,\n                sender,\n                receiver,\n                memo,\n                EXTRACT(EPOCH FROM created_at)::BIGINT AS \"created_at!\",\n                source as \"source!: TransferSource\"\n            ",
