  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                markets.id,\n                markets.description,\n                markets.state as \"state: MarketState\",\n                markets.owner_id,\n                markets.message_id,\n                markets.channel_id,\n                markets.thread_id,\n                markets.details_msg_id,\n                markets.tag\n            FROM\n                markets\n            JOIN\n                instruments ON instruments.market_id = markets.id\n            WHERE\n                instruments.id = $1\n            ",
