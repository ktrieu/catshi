# Rendered by the nginx image's envsubst entrypoint; only ${API_URL} is
# substituted since it's the only one set in the environment.
server {
    listen 80;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Docker's embedded DNS. Resolving per request means nginx starts even if
    # the API container isn't up yet.
    resolver 127.0.0.11 valid=10s;
    set $api_upstream ${API_URL};

    # The API routes have no /api prefix, so strip it when forwarding.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite content-hashes everything under /assets.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback so client-side routes survive a refresh.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
